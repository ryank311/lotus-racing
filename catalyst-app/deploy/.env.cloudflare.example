# Copy to .env.cloudflare. This file is for docker compose, not shell sourcing.
CATALYST_IMAGE=ghcr.io/ryank311/catalyst-coach:latest

# NAS path. The Mac test script overrides this with its own persistent folder.
CATALYST_NAS_DATA_DIR=/volume1/docker/catalyst-coach/data

# Hostname only, without https:// or a trailing slash.
CATALYST_PUBLIC_HOSTNAME=coach.kingracing.net

# Obtain from a remotely managed Cloudflare Tunnel's Docker install command.
# Keep the real .env.cloudflare private; it is gitignored.
CLOUDFLARE_TUNNEL_TOKEN=
