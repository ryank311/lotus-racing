# Use latest after the main branch's Container image workflow has succeeded.
# For a reproducible deployment, use the sha-<commit> tag from GitHub Actions.
CATALYST_IMAGE=ghcr.io/ryank311/catalyst-coach:latest

# Absolute NAS folder: all databases, telemetry, tokens, and settings live here.
# Create it and chown it to 1000:1000 BEFORE starting the project.
# Keep this path unchanged when upgrading or moving the Compose files.
CATALYST_NAS_DATA_DIR=/volume1/docker/catalyst-coach/data
